# ── NEVER commit VIDA-derived data or credentials ───────────────────────────
# This repo ships CODE, not DATA. Everything below is built locally from YOUR
# licensed VIDA install and must stay on your machine.

# The VIDA install itself (the 20+ GB copied from the Windows VIDA VM)
vida/
vida-install/

# SQL Server database files / working copies (originals stay in your VIDA install)
mssql-data/
*.mdf
*.ldf
*.ndf
*.bak

# Built knowledge-base stores (regenerated by `make ingest`)
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal
data/vectors/
data/ft/

# Credentials & per-install config (unique to your VIDA install)
.env
car.toml

# Eval artifacts derived from VIDA content
vida-eval/results/
vida-eval/benchmark.jsonl
vida-eval/frozen_split.json

# Model weights (live on Hugging Face, not here)
*.gguf
*.safetensors

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
