# Copy to .env (gitignored) and set YOUR OWN VIDA install's SQL Server credentials.
# These are unique to your VIDA installation — never commit real values.

# Setup-time (attaching DBs, creating the read-only login): your install's sysadmin login.
VIDA_SQL_SERVER=127.0.0.1
VIDA_SQL_PORT=1433

# Runtime: the read-only login the MCP tools use (created during setup; write-blocked).
# For first setup you may point these at 'sa'; the bootstrap creates 'vida_ro' and you
# switch these to it so 'sa' is never used at runtime.
VIDA_SQL_USER=vida_ro
VIDA_SQL_PASSWORD=your-read-only-password-here

# Local embedding endpoint for hybrid retrieval (OpenAI-compatible: Ollama or LM Studio).
EMBED_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
